[run]
source = apps
omit =
    */migrations/*
    */tests/*
    */test/*
    */tests.py
    manage.py
    bma/*
    */asgi.py
    */wsgi.py

[report]
exclude_lines =
    pragma: no cover
    def __repr__
    raise AssertionError
    raise NotImplementedError
    if __name__ == .__main__.:
    if settings.DEBUG
    pass
