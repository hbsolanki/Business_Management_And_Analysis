# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_URL=your_cloudinary_url

# Django Settings
DEBUG=FALSE
SECRET_KEY=your_secret_key
CORS_ALLOW_ALL_ORIGINS=True
ACCESS_TOKEN_LIFETIME=600
REFRESH_TOKEN_LIFETIME=7
MEDIA_URL='/media/'

# Redis/Cache Configuration
REDIS_PASSWORD=your_redis_password
REDIS_URL=redis://your_redis_host:port
CELERY_BROKER_URL=redis://your_redis_host:port/0
CELERY_RESULT_BACKEND=redis://your_redis_host:port/1

# Database Configuration
DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASS=your_db_password
DB_HOST=your_db_host
DB_PORT=5432

# Celery Configuration
CELERY_ACCEPT_CONTENT=json
CELERY_TASK_SERIALIZER=json
CELERY_TIMEZONE=Asia/Kolkata
CELERY_TASK_TRACK_STARTED=True
CELERY_TASK_TIME_LIMIT=1800

# Email Configuration (Brevo/SMTP)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=your_smtp_password
DEFAULT_FROM_EMAIL=your_email@example.com
DEFAULT_FROM_NAME_EMAIL=BMA
BREVO_API_KEY=your_brevo_api_key

# External APIs
GROQ_API_KEY=your_groq_api_key
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_API_KEY=your_google_api_key
GOOGLE_MODEL=gemini-3.1-flash-lite-preview

# Payment Configuration (Stripe)
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# AI/MCP Configuration
OPEN_ROUTER_API_KEY=your_open_router_api_key
MCP_SERVER_ROOT=http://localhost:1122
